@{
    ViewData["Title"] = "City Planning";
    var isPlacementOpen = (bool)ViewBag.IsPlacementOpen;
    var isMapAdmin = (bool)ViewBag.IsMapAdmin;
    var userCampSeasonId = (string)ViewBag.UserCampSeasonId;
    var seasonsWithout = (List<Humans.Application.Interfaces.CampSeasonSummaryDto>)ViewBag.SeasonsWithoutCampPolygon;
    var placementOpensAt = ViewBag.PlacementOpensAt as NodaTime.LocalDateTime?;
    var placementClosesAt = ViewBag.PlacementClosesAt as NodaTime.LocalDateTime?;
    var showPlacementCard = isPlacementOpen || placementOpensAt.HasValue || placementClosesAt.HasValue;
}

@section Styles {
    <link rel="stylesheet" href="~/dist/city-planning.css" asp-append-version="true" />
    <style>
        /* Override the main layout to occupy the whole screen space */
        .main-content { display: flex; max-width: 100vw; padding: 0; }
        main { display: flex; flex: 1; padding: 0; }

        /* Map page: positioned context for overlay cards, toolbar, and cursors */
        #map-page { flex: 1; position: relative; overflow: hidden; }

        /* React root fills the map page completely */
        #city-planning-root { width: 100%; height: 100%; }

        .remote-cursor {
            position: relative; background: rgba(255,165,0,0.85); color: white;
            margin-top: 6px; margin-left: 6px;
            padding: 2px 7px; border-radius: 0 4px 4px 4px; font-size: 12px;
            white-space: nowrap; pointer-events: none; width: fit-content;
        }
        .remote-cursor::after {
            content: ''; position: absolute; top: -6px; left: -6px;
            border-right: 12px solid transparent;
            border-top: 12px solid rgba(255,165,0,0.85);
        }
    </style>
}

@* #map-page: positioned ancestor for the static overlay cards, toolbar, and cursor markers. *@
<div id="map-page">

    @* Static overlay cards — server-rendered, no dynamic behavior. *@
    @if (showPlacementCard)
    {
    <div class="position-absolute top-0 start-0 m-3" style="z-index:10">
        <div class="card shadow-sm">
            <div class="card-body py-2 px-3 d-flex flex-column align-items-center gap-1">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold">@Localizer["CityPlanning_PlacementPhase"]</span>
                    @if (isPlacementOpen)
                    {
                        <span class="badge bg-success">@Localizer["CityPlanning_StatusOpen"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["CityPlanning_StatusClosed"]</span>
                    }
                </div>
                <button class="btn btn-primary btn-sm small" data-bs-toggle="modal" data-bs-target="#placement-help-modal">
                    <i class="fa fa-question-circle me-1"></i>@Localizer["CityPlanning_HelpButton"]
                </button>
            </div>
        </div>
    </div>
    }

    @if (isMapAdmin)
    {
    <div class="position-absolute top-0 end-0 m-3" style="z-index:10">
        <div class="card shadow-sm">
            <div class="card-body d-flex flex-column align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <a href="/CityPlanning/Admin" class="btn btn-outline-primary btn-sm shadow-sm">
                        <i class="fa fa-cog me-1"></i> @Localizer["CityPlanning_AdminLink"]
                    </a>
                </div>
            </div>
        </div>
    </div>
    }

    @* React root — map, toolbar, history offcanvas rendered here.
       It fills #map-page completely; position:absolute children (toolbar, cursors)
       are positioned relative to #map-page (the nearest positioned ancestor). *@
    <div id="city-planning-root"
         data-user-camp-season-id="@userCampSeasonId"
         data-is-placement-open="@(isPlacementOpen ? "true" : "false")"
         data-is-map-admin="@(isMapAdmin ? "true" : "false")"
         data-seasons-without-polygon="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(seasonsWithout.Select(s => new { campSeasonId = s.CampSeasonId, campName = s.CampName })))">
    </div>

</div>

@if (showPlacementCard)
{
    @await Html.PartialAsync("_PlacementHelpModal")
}

@* Anti-forgery token for AJAX calls (read by React components) *@
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/dist/city-planning.js" asp-append-version="true"></script>
}
